#!/bin/bash
# Forced command for the rbench user: run one pushed benchmark binary on the host without persisting anything.
#
# Invoked by sshd with the client's request in SSH_ORIGINAL_COMMAND:
#   run <year> <day> <threads> <multiversion> <checksum> [-v]   # tar.zst of "bench" and "input.txt" on stdin
#   status
#
# A run stops the main aoc-bench service, then checks the binary, runs it under aoc-bench's debug command and
# streams the resulting JSON run series to stdout. Only warnings and errors go to stderr unless -v is given. Only
# one run can be active at a time.
# The main service is not restarted here. aoc-bench-watchdog restarts it a few minutes after the last run.
#
# The pushed binary is trusted but still confined: Landlock allows it to read the system and the job directory and
# to write only to the job's scratch directory, it gets an empty network namespace, and a timeout bounds how long
# it can run.
set -euo pipefail

RUN_DIR=/run/aoc-bench-rbench
LOCK_FILE="$RUN_DIR/lock"
PAUSED_FILE="$RUN_DIR/paused"
CURRENT_FILE="$RUN_DIR/current"

# Uploads are unpacked under /tmp, as /run is mounted noexec
JOB_DIR_TEMPLATE="${TMPDIR:-/tmp}/aoc-bench-rbench.XXXXXXXX"

# Copied here by bench-all.sh after each build so the rbench runs use the same aoc-bench as the main loop
AOC_BENCH_DIR=/var/lib/aoc-bench
AOC_BENCH_BIN="$AOC_BENCH_DIR/aoc-bench"
HOST_CONFIG="$AOC_BENCH_DIR/host.json"

MAIN_SERVICE=aoc-bench.service

MAX_UPLOAD_BYTES=$((256 * 1024 * 1024))
CHECK_TIMEOUT=300
BENCH_TIMEOUT=1800

verbose=0
log_level=warn

die() {
    echo "aoc-bench-rbench: $*" >&2
    exit 1
}

log() {
    if (( verbose )); then
        echo "$*" >&2
    fi
}

job_dir=""
child_pid=""

cleanup() {
    local rc=$?
    if [[ -n "$child_pid" ]] && kill -0 "$child_pid" 2>/dev/null; then
        # timeout runs in its own process group, so this reaches the benchmark too
        kill -TERM -- "-$child_pid" 2>/dev/null || true
        sleep 1
        kill -KILL -- "-$child_pid" 2>/dev/null || true
    fi
    if [[ -n "$job_dir" ]]; then
        rm -rf -- "$job_dir"
    fi
    rm -f -- "$CURRENT_FILE"
    # Records when the run ended so the watchdog resumes the main service a few minutes later
    touch -- "$LOCK_FILE"
    exit "$rc"
}

# Run a command confined to the job. The order matters: timeout puts itself and everything below it in a new
# process group so the whole tree can be killed, unshare gives an empty network namespace and setpriv applies the
# Landlock rules last so they also cover the command itself. The exec means a backgrounded call's PID is timeout's,
# which is also that group's ID. fd 9 holds the job lock and must not be inherited.
sandboxed() {
    local limit="$1"
    shift
    exec timeout --kill-after=30 "$limit" \
        unshare --user --net --map-current-user \
        setpriv --no-new-privs --landlock-access fs \
            --landlock-rule "path-beneath:execute,read-file,read-dir:/usr" \
            --landlock-rule "path-beneath:read-file,read-dir:/etc" \
            --landlock-rule "path-beneath:read-file,read-dir:/proc" \
            --landlock-rule "path-beneath:read-file,read-dir:/sys" \
            --landlock-rule "path-beneath:read-file,write-file:/dev/null" \
            --landlock-rule "path-beneath:execute,read-file,read-dir:$AOC_BENCH_DIR" \
            --landlock-rule "path-beneath:execute,read-file,read-dir:$job_dir" \
            --landlock-rule "path-beneath:read-file,write-file,read-dir,make-reg,make-dir,remove-file,remove-dir,truncate:$job_dir/tmp" \
            -- env -i \
                PATH=/usr/bin:/bin \
                HOME="$job_dir/tmp" \
                TMPDIR="$job_dir/tmp" \
                LOG_LEVEL="$log_level" \
                "$@" 9>&-
}

print_status() {
    echo "$MAIN_SERVICE: $(systemctl show -p ActiveState --value "$MAIN_SERVICE")"
    if [[ -e "$LOCK_FILE" ]] && ! flock -n "$LOCK_FILE" true; then
        echo "rbench running: $(cat "$CURRENT_FILE" 2>/dev/null || echo unknown)"
    else
        echo "no rbench running"
    fi
    if [[ -e "$PAUSED_FILE" ]]; then
        echo "main service paused for rbench runs since $(date -u -r "$PAUSED_FILE" +%FT%TZ)"
    fi
}

run_benchmark() {
    local year="$1" day="$2" threads="$3" multiversion="$4" checksum="$5"
    local upload size check_checksum check_multiversion check_multithreading
    local affinity disable_aslr power_limit_watts started stop_pid paused_here rc
    local -a command

    [[ "$year" =~ ^20[0-9]{2}$ ]] || die "invalid year '$year'"
    [[ "$day" =~ ^(0[1-9]|1[0-9]|2[0-5])$ ]] || die "invalid day '$day', expected 01-25"
    [[ "$threads" =~ ^([1-9][0-9]?|n)$ ]] || die "invalid threads '$threads', expected 1-99 or n"
    [[ "$multiversion" =~ ^[A-Za-z0-9_]{1,32}$ ]] || die "invalid multiversion '$multiversion'"
    [[ "$checksum" =~ ^[0-9a-f]{16}$ ]] || die "invalid checksum '$checksum', expected 16 hex digits"

    [[ -x "$AOC_BENCH_BIN" ]] || die "$AOC_BENCH_BIN not found, the main service has not copied a build here yet"
    [[ -f "$HOST_CONFIG" ]] || die "$HOST_CONFIG not found, the main service has not copied a build here yet"

    # One run at a time. The lock is held for the rest of the script and released by the kernel on exit. The short
    # wait covers the watchdog, which holds the lock for the moment it takes to restart the main service.
    exec 9>>"$LOCK_FILE"
    if ! flock -w 10 9; then
        die "another rbench is running: $(cat "$CURRENT_FILE" 2>/dev/null || echo unknown)"
    fi
    touch -- "$LOCK_FILE"
    printf '%s-%s threads=%s multiversion=%s started %s\n' \
        "$year" "$day" "$threads" "$multiversion" "$(date -u +%FT%TZ)" > "$CURRENT_FILE"
    trap cleanup EXIT
    trap 'exit 130' INT TERM HUP PIPE

    # Pause the main loop straight away. The marker tells the watchdog to resume it later, so a service someone else
    # stopped is left alone. The stop waits for the current benchmark group, so it runs in the background while the
    # upload is received.
    paused_here=0
    started="$(date +%s)"
    case "$(systemctl show -p ActiveState --value "$MAIN_SERVICE")" in
        inactive|failed)
            log "$MAIN_SERVICE is not running"
            true &
            ;;
        *)
            touch -- "$PAUSED_FILE"
            paused_here=1
            log "stopping $MAIN_SERVICE, waiting for its current benchmark group to finish..."
            systemctl stop "$MAIN_SERVICE" 9>&- &
            ;;
    esac
    stop_pid=$!

    # Holding the lock means any leftover job directory of ours is from a run that died without cleaning up. Only
    # our own are removed, so a same-named directory someone else left in /tmp cannot fail the run.
    find "$(dirname -- "$JOB_DIR_TEMPLATE")" -maxdepth 1 -name "$(basename -- "${JOB_DIR_TEMPLATE%.XXXXXXXX}").*" \
        -user "$(id -un)" -exec rm -rf -- {} +
    job_dir="$(mktemp -d -- "$JOB_DIR_TEMPLATE")"
    mkdir -- "$job_dir/tmp"

    # Receive the upload, bounded in size, and extract only the two expected members
    upload="$job_dir/upload.tar.zst"
    head -c "$((MAX_UPLOAD_BYTES + 1))" > "$upload"
    size="$(stat -c %s -- "$upload")"
    (( size > 0 )) || die "no upload received on stdin"
    (( size <= MAX_UPLOAD_BYTES )) || die "upload exceeds $MAX_UPLOAD_BYTES bytes"
    zstd -dq --stdout -- "$upload" \
        | tar -x -C "$job_dir" --no-same-owner --no-same-permissions -- bench input.txt
    rm -f -- "$upload"
    [[ -f "$job_dir/bench" && ! -L "$job_dir/bench" ]] || die "upload must contain a regular file named bench"
    [[ -f "$job_dir/input.txt" && ! -L "$job_dir/input.txt" ]] || die "upload must contain a regular file named input.txt"
    chmod 0555 -- "$job_dir/bench"
    chmod 0444 -- "$job_dir/input.txt"

    set +e
    wait "$stop_pid"
    rc=$?
    set -e
    if (( rc != 0 )); then
        if (( paused_here )); then
            rm -f -- "$PAUSED_FILE"
        fi
        die "failed to stop $MAIN_SERVICE"
    fi
    if (( paused_here )); then
        log "$MAIN_SERVICE stopped after $(( $(date +%s) - started ))s"
    fi
    touch -- "$LOCK_FILE"

    # Confirm the binary runs here and agrees with the client. Only correctness is checked.
    log "checking $year-$day on the host..."
    sandboxed "$CHECK_TIMEOUT" "$job_dir/bench" check < "$job_dir/input.txt" > "$job_dir/check.out" &
    child_pid=$!
    set +e
    wait "$child_pid"
    rc=$?
    set -e
    child_pid=""
    if (( rc != 0 )); then
        die "check run failed with exit code $rc"
    fi
    check_checksum="$(sed -n 's/^Checksum: //p' "$job_dir/check.out")"
    check_multiversion="$(sed -n 's/^Multiversion: //p' "$job_dir/check.out")"
    check_multithreading="$(sed -n 's/^Multithreading: //p' "$job_dir/check.out")"
    [[ "$check_checksum" == "$checksum" ]] \
        || die "checksum mismatch: client expected $checksum, host computed ${check_checksum:-nothing}"
    if ! grep -qx -- "$multiversion" <<< "${check_multiversion//,/$'\n'}"; then
        die "multiversion '$multiversion' not supported, binary offers: $check_multiversion"
    fi
    if [[ "$threads" != "1" && "$threads" != "n" && "$check_multithreading" != "true" ]]; then
        die "threads=$threads requested but the binary does not use multithreading"
    fi

    # select rather than // so an explicit false is passed on instead of being treated as missing
    affinity="$(jq -r 'select(.cpu_affinity != null) | .cpu_affinity' "$HOST_CONFIG")"
    disable_aslr="$(jq -r 'select(.disable_aslr != null) | .disable_aslr' "$HOST_CONFIG")"
    command=("$AOC_BENCH_BIN" debug --input "$job_dir/input.txt" --checksum "$checksum")
    if [[ -n "$affinity" ]]; then
        command+=(--cpu-affinity "$affinity")
    fi
    if [[ -n "$disable_aslr" ]]; then
        command+=(--disable-aslr "$disable_aslr")
    fi
    power_limit_watts="$(jq -r 'select(.power_limit_watts != null) | .power_limit_watts' "$HOST_CONFIG")"
    if [[ -n "$power_limit_watts" ]]; then
        command+=(--power-limit-watts "$power_limit_watts")
    fi
    command+=(-- "$job_dir/bench" bench "$threads" "$multiversion")

    log "running $year-$day threads=$threads multiversion=$multiversion"
    sandboxed "$BENCH_TIMEOUT" "${command[@]}" < /dev/null &
    child_pid=$!
    set +e
    wait "$child_pid"
    rc=$?
    set -e
    child_pid=""
    if (( rc != 0 )); then
        die "benchmark run failed with exit code $rc"
    fi
}

main() {
    local request
    local -a words

    # sshd passes the client's command line through the environment. Direct invocation uses the arguments.
    request="${SSH_ORIGINAL_COMMAND:-$*}"
    read -r -a words <<< "$request"

    [[ -d "$RUN_DIR" ]] || die "$RUN_DIR does not exist"

    case "${words[0]:-}" in
        run)
            if (( ${#words[@]} == 7 )) && [[ "${words[6]}" == "-v" ]]; then
                verbose=1
                log_level=info
                unset 'words[6]'
            fi
            (( ${#words[@]} == 6 )) || die "usage: run <year> <day> <threads> <multiversion> <checksum> [-v]"
            run_benchmark "${words[@]:1}"
            ;;
        status)
            (( ${#words[@]} == 1 )) || die "usage: status"
            print_status
            ;;
        *)
            die "usage: run <year> <day> <threads> <multiversion> <checksum> [-v] | status"
            ;;
    esac
}

main "$@"
