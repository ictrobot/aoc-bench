# Generated by setup.yml from bench_tuned_overrides in this host's host_vars. Options replace the same-named option
# inherited from the aoc-bench profile or its parents, and new cmdline_* options are applied after the inherited ones.
[main]
summary=aoc-bench with {{ inventory_hostname }} overrides
include=aoc-bench
{% for section, options in (bench_tuned_overrides | default({})).items() %}

[{{ section }}]
{% for option, value in options.items() %}
{{ option }}={{ value }}
{% endfor %}
{% endfor %}
