// Let the rbench user stop the main aoc-bench service.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "{{ rbench_user }}") {
        return;
    }
    if (action.lookup("unit") === "aoc-bench.service" && action.lookup("verb") === "stop") {
        return polkit.Result.YES;
    }
});
